const fetchAndFilterUsers = async () => {
  try {
    // Fetch user data from JSONPlaceholder API
    const response = await fetch("https://jsonplaceholder.typicode.com/users");
    if (!response.ok) {
      throw new Error(`HTTP error! Status: ${response.status}`);
    }
    const users = await response.json();
    // Filter users whose company catchPhrase contains "group" or "service" (case-insensitive)
    const filteredUsers = users.filter(({ company: { catchPhrase } }) => {
      const phrase = catchPhrase.toLowerCase();
      return phrase.includes("group") || phrase.includes("service");
    });
    // Transform filtered data into formatted strings using Object Destructuring
    const formattedStrings = filteredUsers.map(
      ({ name, email, address: { city } }) =>
        `User: ${name} | Email: ${email} | City: ${city}`
    );
    // Display results
    console.log("=== Filtered & Formatted Users ===\n");
    formattedStrings.forEach((str) => console.log(str));
    return formattedStrings;
  } catch (error) {
    console.error("Error fetching user data:", error.message);
  }
};
// Execute
fetchAndFilterUsers();
